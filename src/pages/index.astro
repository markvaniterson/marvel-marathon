// ---------- State ----------
const store = {
  get watched() { return new Set(JSON.parse(localStorage.getItem("mm-watched") || "[]")); },
  toggle(id) {
    const w = this.watched;
    w.has(id) ? w.delete(id) : w.add(id);
    localStorage.setItem("mm-watched", JSON.stringify([...w]));
    pushState();
  },
  get order() { return localStorage.getItem("mm-order"); },
  set order(v) {
    v ? localStorage.setItem("mm-order", v) : localStorage.removeItem("mm-order");
    pushState();
  },
};

// ---------- Account-sync (localStorage blijft de bron; server volgt voor ingelogde gebruikers) ----------
let loggedIn = false;
function pushState() {
  if (!loggedIn) return;
  fetch("/api/state", {
    method: "PUT",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ watched: [...store.watched], route: store.order }),
  }).catch(() => {});
}
async function syncFromServer() {
  try {
    const r = await fetch("/api/state");
    if (!r.ok) return;
    const s = await r.json();
    const local = store.watched;
    const union = new Set([...s.watched, ...local]);
    localStorage.setItem("mm-watched", JSON.stringify([...union]));
    // Route: server wint (ander apparaat kan hem gewijzigd hebben), tenzij daar nog niets staat
    if (s.route && ORDERS[s.route]) localStorage.setItem("mm-order", s.route);
    if (union.size !== s.watched.length || s.route !== store.order) pushState();
    render();
  } catch {}
}

const $ = (id) => document.getElementById(id);
const poster = (f, w = "w342") => IMG + w + "/" + f.po;
const backdrop = (f) => IMG + "w780/" + f.bd;
const hours = (ids) => Math.round(ids.reduce((s, id) => s + (FILMS[id].min || 0), 0) / 60);
const TYPES = { s: "Serie", k: "Short", x: "Special" };
const typeLabel = (f) => TYPES[f.type] || "Film";
// Duur-tekst: series tonen afleveringen, al het andere minuten
const fmt = (f) => f.eps
  ? `${f.eps} afl.${f.seasons ? ` · ${f.seasons} seizoenen` : ""}`
  : (f.min ? `${f.min} min` : "duur nog onbekend");
// ponytail: 90 dagen als bioscoopvenster-heuristiek; klopt ruim genoeg voor een badge
function status(f) {
  if (!f.date) return null;
  const diff = (Date.now() - new Date(f.date)) / 864e5;
  if (diff < 0) return { label: `Verwacht · ${new Date(f.date).toLocaleDateString("nl-NL", { month: "long", year: "numeric" })}`, chip: String(f.y) };
  if (diff < 90) return { label: "Nu in de bioscoop", chip: "Bios" };
  return null;
}
const ICON_CHECK = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';

// ---------- Intro ----------
(function intro() {
  const el = $("intro");
  const seen = localStorage.getItem("mm-intro");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const end = () => el.classList.add("hide");
  el.addEventListener("click", end);
  el.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); end(); }
  });
  if (seen || reduced) {
    // Terugkerend bezoek: korte wordmark-beat i.p.v. de volledige flipbook
    el.classList.add("quick");
    setTimeout(end, reduced ? 1600 : 1100);
  } else {
    // ponytail: 8 posters volstaan voor het flip-effect; meer laadt alleen maar trager
    const flip = ["av1","gotg","th3","bp1","av3","spm3","dpw","av4"];
    $("montage").innerHTML = flip.map((id, i) =>
      `<img src="${poster(FILMS[id], "w342")}" alt="" style="animation-delay:${(i * 0.3).toFixed(2)}s">`).join("");
    setTimeout(end, 4000);
  }
  localStorage.setItem("mm-intro", "1");
})();

// ---------- Router ----------
function render() {
  const order = ORDERS[store.order];
  order ? renderWatch(order) : renderPick();
}

// ---------- Route picker ----------
function renderPick() {
  $("pick").classList.remove("hidden");
  $("watch").classList.add("hidden");
  $("btn-switch").classList.add("hidden");
  $("counter").textContent = "";
  $("bar").style.width = "0";

  $("routes").innerHTML = Object.entries(ORDERS).map(([key, o]) => {
    const unit = o.ids.some(id => FILMS[id].type) ? "titels" : "films";
    return `
    <button class="route" data-order="${key}" aria-label="${o.name}: ${o.ids.length} ${unit}, ongeveer ${hours(o.ids)} uur">
      <span class="fan" aria-hidden="true">${(o.fan || o.ids.slice(0, 3)).map(id =>
        `<img src="${poster(FILMS[id], "w185")}" alt="" onerror="this.style.visibility='hidden'">`).join("")}</span>
      <span>
        <h3>${o.name}</h3>
        <p>${o.desc}</p>
        <span class="facts">${o.ids.length} ${unit} <span>· ± ${hours(o.ids)} uur kijktijd</span></span>
      </span>
    </button>`;
  }).join("");
  document.querySelectorAll(".route").forEach(b =>
    b.addEventListener("click", () => { store.order = b.dataset.order; render(); window.scrollTo(0, 0); }));
}

// ---------- Watch screen ----------
function renderWatch(order) {
  $("pick").classList.add("hidden");
  $("watch").classList.remove("hidden");
  $("btn-switch").classList.remove("hidden");
  $("route-name").textContent = order.name;

  const watched = store.watched;
  const nextId = order.ids.find(id => !watched.has(id));
  const done = order.ids.filter(id => watched.has(id)).length;

  $("bar").style.width = (done / order.ids.length * 100) + "%";
  $("counter").innerHTML = `${done}<em> / ${order.ids.length}</em>`;

  const hero = $("hero");
  if (nextId) {
    const f = FILMS[nextId];
    hero.innerHTML = `
      <div class="hero">
        <div class="backdrop"><img src="${backdrop(f)}"
          srcset="${IMG}w780/${f.bd} 780w, ${IMG}w1280/${f.bd} 1280w"
          sizes="(min-width: 760px) 1068px, 100vw"
          alt="" onerror="this.style.display='none'"></div>
        <div class="content">
          <img class="poster" src="${poster(f)}" alt="Poster van ${f.t}" onerror="this.style.display='none'">
          <div class="info">
            <h3>${f.t}</h3>
            <p class="meta"><b>${f.y}</b> · ${fmt(f)} · Fase ${f.ph} · ${status(f) ? status(f).label : f.plat}</p>
            <div class="cta">
              <button class="btn btn-primary" id="hero-done">${ICON_CHECK} Gekeken</button>
              <button class="btn btn-ghost" id="hero-info">Details</button>
            </div>
          </div>
        </div>
      </div>`;
    $("hero-done").onclick = () => { store.toggle(nextId); showToast(nextId); render(); };
    $("hero-info").onclick = () => openSheet(nextId);
  } else {
    hero.innerHTML = `
      <div class="hero finale">
        <div class="content">
          <h3>Marathon voltooid</h3>
          <p>Alle ${order.ids.length} films van deze route gezien — Excelsior! Kies een andere route of vink een film uit om opnieuw te kijken.</p>
          <div class="cta"><button class="btn btn-ghost" id="hero-switch">Kies een andere route</button></div>
        </div>
      </div>`;
    $("hero-switch").onclick = () => { store.order = null; render(); };
  }

  $("grid").innerHTML = order.ids.map((id, i) => {
    const f = FILMS[id];
    const w = watched.has(id);
    return `
      <button class="tile ${w ? "watched" : ""}${id === nextId ? " next" : ""}" data-id="${id}"
        aria-label="${f.t} (${f.y}), ${typeLabel(f).toLowerCase()} ${i + 1}${w ? ", gekeken" : ""}">
        <img src="${poster(f)}" alt="" loading="lazy"
          onerror="this.remove();this.parentElement.insertAdjacentHTML('afterbegin','<span class=\'fallback\'>${f.t.replace(/'/g, "\\'")}</span>')">
        <span class="num">${i + 1}</span>
        ${f.type ? `<span class="kind">${typeLabel(f)}</span>` : ""}
        ${status(f) ? `<span class="kind hot">${status(f).chip}</span>` : ""}
        <span class="done">${ICON_CHECK}</span>
      </button>`;
  }).join("");
  document.querySelectorAll(".tile").forEach(b =>
    b.addEventListener("click", () => openSheet(b.dataset.id)));
}
$("btn-switch").addEventListener("click", () => { store.order = null; render(); });

// ---------- Detail sheet ----------
let lastFocus = null;
function openSheet(id) {
  const f = FILMS[id];
  const w = store.watched.has(id);
  lastFocus = document.activeElement;
  $("sheet").innerHTML = `
    <div class="sheet-head" id="sheet-head">
      <img class="bd" src="${backdrop(f)}" alt="" onerror="this.style.display='none'">
      ${f.yt ? `<button class="play-trailer" id="btn-trailer" aria-label="Trailer afspelen">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
        <span>Trailer</span>
      </button>` : ""}
      <button class="sheet-close" id="sheet-close" aria-label="Sluiten">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="sheet-body">
      <div class="sheet-top">
        <img class="poster" src="${poster(f)}" alt="Poster van ${f.t}" onerror="this.style.display='none'">
        <div>
          <h3>${f.t}</h3>
          <p class="meta">${typeLabel(f)} · ${f.y} · ${fmt(f)} · MCU Fase ${f.ph}</p>
        </div>
      </div>
      <p class="desc">${f.d}</p>
      <div class="avail">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M8 23h8"/></svg>
        <span id="avail-text">${status(f) ? `<b>${status(f).label}</b>` : `Te zien op <b>${f.plat}</b>`}</span>
      </div>
      <div class="sheet-actions">
        ${w
          ? `<button class="btn-undo" id="sheet-toggle">Markeer als niet gekeken</button>`
          : `<button class="btn btn-primary" id="sheet-toggle">${ICON_CHECK} Gekeken</button>`}
      </div>
    </div>`;
  $("overlay").classList.add("open");
  $("overlay").setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
  fetchProvider(id).then(v => {
    const el = $("avail-text");
    if (v && el && $("sheet").contains(el)) el.innerHTML = `Nu te zien op <b>${v}</b>`;
  });
  $("sheet-toggle").onclick = () => { store.toggle(id); if (!w) showToast(id); closeSheet(); render(); };
  const bt = $("btn-trailer");
  if (bt) bt.onclick = () => openTrailer(f);
  $("sheet-close").onclick = closeSheet;
  requestAnimationFrame(() => $("sheet-close").focus());
}
function closeSheet() {
  $("overlay").classList.remove("open");
  $("overlay").setAttribute("aria-hidden", "true");
  document.body.style.overflow = "";
  if (lastFocus) lastFocus.focus();
}
$("overlay").addEventListener("click", (e) => { if (e.target.id === "overlay") closeSheet(); });
document.addEventListener("keydown", (e) => {
  if (e.key !== "Escape") return;
  if ($("trailer").classList.contains("open")) closeTrailer();
  else if ($("overlay").classList.contains("open")) closeSheet();
});
$("sheet").addEventListener("keydown", (e) => {
  if (e.key !== "Tab") return;
  const f = [...$("sheet").querySelectorAll("button, a[href]")];
  if (!f.length) return;
  const first = f[0], last = f[f.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
});

// ---------- Trailer (fullscreen, ook liggend op mobiel) ----------
function openTrailer(f) {
  $("trailer-frame").src = `https://www.youtube-nocookie.com/embed/${f.yt}?autoplay=1&rel=0`;
  $("trailer").classList.add("open");
  // Echt fullscreen waar het kan (Android/desktop); iOS toont de overlay + YouTube's eigen fullscreen-knop
  const req = $("trailer").requestFullscreen || $("trailer").webkitRequestFullscreen;
  if (req) { try { req.call($("trailer")).catch(() => {}); } catch {} }
}
function closeTrailer() {
  if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
  $("trailer").classList.remove("open");
  $("trailer-frame").src = "";
}
$("trailer-close").addEventListener("click", closeTrailer);
document.addEventListener("fullscreenchange", () => {
  if (!document.fullscreenElement && $("trailer").classList.contains("open")) closeTrailer();
});

// ---------- Live streamingdata (via eigen /api/providers, key blijft server-side) ----------
// ponytail: cache 24u in localStorage; bij een falende API valt de app terug op de vaste indicatie
async function fetchProvider(id) {
  const f = FILMS[id];
  if (!f.id) return null;
  const cacheKey = `mm-prov-${f.id}`;
  const hit = JSON.parse(localStorage.getItem(cacheKey) || "null");
  if (hit && Date.now() - hit.at < 864e5) return hit.v;
  try {
    const r = await fetch(`/api/providers?kind=${f.tv ? "tv" : "movie"}&id=${f.id}`);
    if (!r.ok) return null;
    const v = (await r.json()).providers.slice(0, 2).join(" / ") || null;
    localStorage.setItem(cacheKey, JSON.stringify({ at: Date.now(), v }));
    return v;
  } catch { return null; }
}

// ---------- Toast (ongedaan maken) ----------
let toastTimer = null, toastId = null;
function showToast(id) {
  toastId = id;
  $("toast-msg").textContent = `${FILMS[id].t} afgevinkt`;
  $("toast").classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => $("toast").classList.remove("show"), 5000);
}
$("toast-undo").addEventListener("click", () => {
  if (toastId) { store.toggle(toastId); toastId = null; }
  $("toast").classList.remove("show");
  render();
});

// ---------- iOS "Zet op beginscherm"-hint ----------
(function a2hs() {
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent);
  const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
  if (!isIOS || standalone || localStorage.getItem("mm-a2hs")) return;
  $("a2hs").classList.add("show");
  $("a2hs-close").onclick = () => {
    localStorage.setItem("mm-a2hs", "1");
    $("a2hs").classList.remove("show");
  };
})();

// ---------- Init ----------
const preset = new URLSearchParams(location.search).get("route");
if (preset && ORDERS[preset]) store.order = preset;
render();

// ---------- Sessie, login- & account-modal ----------
let sessionUser = null;

const SHEET_CLOSE_SVG = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>`;
const PROVIDER_ICONS = {
  google: `<svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.7 2.4 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.2C12.4 13.5 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.4 6.9-17.7z"/><path fill="#FBBC05" d="M10.5 28.6c-.5-1.5-.8-3-.8-4.6s.3-3.1.8-4.6l-7.9-6.2C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.8l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.6l-7.7-6c-2.1 1.4-4.8 2.3-7.5 2.3-6.3 0-11.6-4-13.5-9.6l-7.9 6.2C6.5 42.6 14.6 48 24 48z"/></svg>`,
  apple: `<svg width="20" height="20" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>`,
};

async function signIn(provider) {
  const { csrfToken } = await (await fetch("/api/auth/csrf")).json();
  const form = document.createElement("form");
  form.method = "POST";
  form.action = `/api/auth/signin/${provider}`;
  for (const [name, value] of [["csrfToken", csrfToken], ["callbackUrl", "/"]]) {
    const input = document.createElement("input");
    input.type = "hidden"; input.name = name; input.value = value;
    form.appendChild(input);
  }
  document.body.appendChild(form);
  form.submit();
}

async function openLogin() {
  lastFocus = document.activeElement;
  $("sheet").innerHTML = `
    <div class="account">
      <button class="sheet-close" id="sheet-close" aria-label="Sluiten">${SHEET_CLOSE_SVG}</button>
      <h3>Inloggen</h3>
      <p class="warn">Log in om je afgevinkte titels en route te synchroniseren op al je apparaten.</p>
      <div id="login-providers"><p class="meta">Laden…</p></div>
    </div>`;
  $("overlay").classList.add("open");
  $("overlay").setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
  $("sheet-close").onclick = closeSheet;
  requestAnimationFrame(() => $("sheet-close").focus());

  const r = await fetch("/api/auth/providers").catch(() => null);
  const provs = r?.ok ? Object.values(await r.json()) : [];
  const box = $("login-providers");
  if (!box) return; // modal alweer dicht
  box.innerHTML = provs.length
    ? provs.map(p => `<button class="provider-btn" data-p="${p.id}">${PROVIDER_ICONS[p.id] ?? ""} Verder met ${p.name}</button>`).join("")
    : `<p class="meta">Inloggen is momenteel niet beschikbaar.</p>`;
  box.querySelectorAll(".provider-btn").forEach(b =>
    b.addEventListener("click", () => { b.disabled = true; signIn(b.dataset.p); }));
}

async function signOut() {
  const { csrfToken } = await (await fetch("/api/auth/csrf")).json();
  await fetch("/api/auth/signout", {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: `csrfToken=${encodeURIComponent(csrfToken)}`,
  });
  location.reload();
}

function openAccount() {
  const u = sessionUser;
  if (!u) return;
  lastFocus = document.activeElement;
  $("sheet").innerHTML = `
    <div class="account">
      <button class="sheet-close" id="sheet-close" aria-label="Sluiten">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      ${u.image ? `<img class="avatar" src="${u.image}" alt="">` : ""}
      <h3>${u.name || "Marvel-kijker"}</h3>
      <p class="meta">${u.email || ""}</p>
      <p class="stats">${store.watched.size} titels afgevinkt — gesynchroniseerd op al je apparaten</p>
      <div class="sheet-actions">
        <button class="btn-undo" id="btn-signout">Uitloggen</button>
      </div>
      <button class="btn-danger" id="btn-delete">Account verwijderen</button>
    </div>`;
  $("overlay").classList.add("open");
  $("overlay").setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
  $("sheet-close").onclick = closeSheet;
  $("btn-signout").onclick = signOut;
  $("btn-delete").onclick = confirmDelete;
  requestAnimationFrame(() => $("sheet-close").focus());
}

function confirmDelete() {
  $("sheet").querySelector(".account").innerHTML = `
    <button class="sheet-close" id="sheet-close" aria-label="Sluiten">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <h3>Account verwijderen?</h3>
    <p class="warn">Dit verwijdert je account en je <b>gesynchroniseerde voortgang op alle apparaten</b> definitief. De voortgang op dit apparaat zelf blijft lokaal bewaard.</p>
    <div class="sheet-actions">
      <button class="btn btn-primary" id="btn-delete-confirm">Ja, verwijder mijn account</button>
      <button class="btn-undo" id="btn-delete-cancel">Annuleren</button>
    </div>`;
  $("sheet-close").onclick = closeSheet;
  $("btn-delete-cancel").onclick = openAccount;
  $("btn-delete-confirm").onclick = async () => {
    const b = $("btn-delete-confirm");
    b.disabled = true; b.textContent = "Bezig met verwijderen…";
    const r = await fetch("/api/account", { method: "DELETE" }).catch(() => null);
    if (r?.ok) location.reload();
    else { b.disabled = false; b.textContent = "Ja, verwijder mijn account"; alert("Verwijderen is niet gelukt — probeer het opnieuw."); }
  };
  requestAnimationFrame(() => $("btn-delete-cancel").focus());
}

const authBtn = $("btn-auth");
if (authBtn) authBtn.onclick = (e) => { e.preventDefault(); openLogin(); };
if (authBtn) fetch("/api/auth/session")
  .then(r => r.ok ? r.json() : null)
  .then(s => {
    if (!s?.user) return;
    loggedIn = true;
    sessionUser = s.user;
    authBtn.setAttribute("aria-label", `Account (${s.user.name || s.user.email})`);
    authBtn.title = "Account";
    authBtn.onclick = (e) => { e.preventDefault(); openAccount(); };
    if (s.user.image) authBtn.innerHTML =
      `<img src="${s.user.image}" alt="" style="width:26px;height:26px;border-radius:50%">`;
    syncFromServer();
  })
  .catch(() => {});
</script>
</body>
</html>
