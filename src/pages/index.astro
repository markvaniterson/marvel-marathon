---
// Login-knop verschijnt pas zodra er een OAuth-provider is geconfigureerd (zie README)
const authReady = Boolean(import.meta.env.AUTH_GOOGLE_ID || import.meta.env.AUTH_APPLE_ID);
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Marvel Marathon</title>
<meta name="theme-color" content="#07080c">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icon-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Marvel">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23e62429'/%3E%3Ctext x='32' y='47' font-family='Arial Black,Arial,sans-serif' font-size='40' font-weight='900' fill='white' text-anchor='middle'%3EM%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://image.tmdb.org" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --bg: #07080c;
    --surface: #10131a;
    --surface2: #181c26;
    --line: #242936;
    --text: #f4f5f7;
    --muted: #a7aebb;
    --red: #e62429;
    --red-deep: #8f1216;
    --display: "Bebas Neue", "Arial Narrow", sans-serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  button, a { touch-action: manipulation; }
  html { background: var(--bg); }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; }
  button { font-family: var(--sans); cursor: pointer; }
  :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; border-radius: 4px; }

  /* ================= Intro ================= */
  #intro {
    position: fixed; inset: 0; z-index: 100; overflow: hidden;
    background: var(--bg); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  #intro .montage { position: absolute; inset: 0; }
  #intro .montage img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0;
    animation: flash .32s linear forwards;
  }
  @keyframes flash { 0% { opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { opacity: 0; } }
  #intro .wash {
    position: absolute; inset: 0;
    background: var(--red);
    mix-blend-mode: multiply;
    opacity: .85;
  }
  #intro .solid {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, #b3151a, #6d090d);
    opacity: 0;
    animation: solidIn .7s ease 2.5s forwards;
  }
  @keyframes solidIn { to { opacity: 1; } }
  #intro .title { position: relative; text-align: center; }
  #intro .title h1 {
    font-family: var(--display);
    font-size: clamp(5rem, 26vw, 6rem);
    letter-spacing: .04em; line-height: .9;
    color: #fff;
    transform: scale(5); opacity: 0;
    animation: settle 2.9s cubic-bezier(.16,.8,.26,1) forwards;
    text-shadow: 0 12px 60px rgba(0,0,0,.5);
  }
  @keyframes settle {
    0% { transform: scale(5); opacity: 0; }
    22% { opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  #intro .title p {
    font-family: var(--display);
    color: #fff; font-size: clamp(1.2rem, 6vw, 1.6rem);
    letter-spacing: .55em; text-indent: .55em;
    opacity: 0; animation: fadeUp .7s ease 2.7s forwards;
  }
  #intro small {
    position: absolute; bottom: max(1.6rem, env(safe-area-inset-bottom));
    left: 0; right: 0; text-align: center;
    color: rgba(255,255,255,.65); font-size: .78rem; letter-spacing: .12em;
    opacity: 0; animation: fadeUp .7s ease .6s forwards;
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  #intro.hide { transition: opacity .55s ease, visibility .55s; opacity: 0; visibility: hidden; pointer-events: none; }
  #intro.quick .montage, #intro.quick small { display: none; }
  #intro.quick .solid { animation: none; opacity: 1; }
  #intro.quick .title h1 { animation: quickIn .8s cubic-bezier(.2,.8,.3,1) forwards; }
  #intro.quick .title p { animation-delay: .2s; }
  @keyframes quickIn { from { transform: scale(1.35); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    #intro .montage { display: none; }
    #intro .solid { animation: none; opacity: 1; }
    #intro .title h1, #intro.quick .title h1 { animation: none; transform: none; opacity: 1; }
    #intro .title p, #intro small { animation: none; opacity: 1; }
  }

  /* ================= Header ================= */
  header.app {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: 1100px; margin: 0 auto;
    display: flex; align-items: center; gap: .8rem;
    padding: .65rem 1rem;
  }
  .wordmark { display: flex; align-items: baseline; gap: .45rem; font-family: var(--display); font-size: 1.35rem; letter-spacing: .05em; }
  .wordmark b { background: var(--red); color: #fff; padding: .05rem .45rem .0rem; border-radius: 3px; font-weight: 400; }
  .wordmark span { color: var(--text); }
  .bar .spacer { flex: 1; }
  .counter { font-family: var(--display); font-size: 1.25rem; letter-spacing: .06em; color: var(--text); white-space: nowrap; }
  .counter em { font-style: normal; color: var(--muted); }
  .icon-btn {
    background: none; border: 1px solid var(--line); color: var(--muted);
    width: 44px; height: 44px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    transition: border-color .15s, color .15s;
  }
  @media (hover: hover) { .icon-btn:hover { border-color: var(--red); color: var(--text); } }
  .progress-track { height: 3px; background: var(--surface2); }
  .progress-track i { display: block; height: 100%; background: var(--red); transition: width .5s cubic-bezier(.22,.9,.3,1); }

  main { max-width: 1100px; margin: 0 auto; padding: 0 1rem 3rem; }
  .hidden { display: none !important; }

  h2.row {
    font-family: var(--display);
    font-size: 1.5rem; letter-spacing: .07em; font-weight: 400;
    margin: 1.8rem 0 .8rem;
  }
  h2.row small { font-family: var(--sans); color: var(--muted); font-size: .85rem; letter-spacing: 0; margin-left: .6rem; }

  /* ================= Route picker ================= */
  #pick .lede { color: var(--muted); font-size: .95rem; margin-top: -.3rem; max-width: 60ch; }
  .routes { display: grid; gap: .9rem; margin-top: 1.1rem; }
  .route {
    display: flex; align-items: center; gap: 1rem; text-align: left;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    padding: 1rem; color: var(--text);
    transition: border-color .15s, transform .15s;
  }
  @media (hover: hover) {
    .route:hover { border-color: var(--red); transform: translateY(-2px); }
    .tile:hover { transform: scale(1.03); }
  }
  .fan { position: relative; width: 92px; height: 108px; flex: none; }
  .fan img {
    position: absolute; width: 64px; aspect-ratio: 2/3; object-fit: cover;
    border-radius: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.55);
    background: var(--surface2);
  }
  .fan img:nth-child(1) { left: 0; top: 10px; transform: rotate(-6deg); }
  .fan img:nth-child(2) { left: 14px; top: 4px; transform: rotate(2deg); }
  .fan img:nth-child(3) { left: 28px; top: 8px; transform: rotate(8deg); }
  .route h3 { font-family: var(--display); font-size: 1.45rem; letter-spacing: .05em; font-weight: 400; }
  .route p { color: var(--muted); font-size: .88rem; line-height: 1.45; margin-top: .15rem; }
  .route .facts { margin-top: .5rem; color: var(--text); font-size: .82rem; font-weight: 600; }
  .route .facts span { color: var(--muted); font-weight: 400; }

  /* ================= Hero (volgende film) ================= */
  .hero {
    position: relative; border-radius: 16px; overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .hero .backdrop { position: absolute; inset: 0; }
  .hero .backdrop img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hero .backdrop::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(7,8,12,.97) 10%, rgba(7,8,12,.88) 35%, rgba(7,8,12,.45) 65%, rgba(7,8,12,.12) 100%);
  }
  .hero { animation: heroIn .45s cubic-bezier(.2,.8,.3,1); }
  @keyframes heroIn { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .hero { animation: none; } }
  .hero .content {
    position: relative; display: flex; align-items: flex-end; gap: 1rem;
    padding: 6.5rem 1.1rem 1.2rem;
  }
  .hero .poster {
    width: 104px; aspect-ratio: 2/3; object-fit: cover; flex: none;
    border-radius: 10px; box-shadow: 0 14px 34px rgba(0,0,0,.6);
    background: var(--surface2);
  }
  .hero .info { min-width: 0; }
  .hero h3 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.9rem, 7.5vw, 3rem); letter-spacing: .03em; line-height: .95;
    /* Vaste ruimte voor 3 regels, titel onderin verankerd: de Gekeken-knop
       blijft zo op dezelfde plek, ook bij korte titels als "Iron Man" */
    min-height: 2.85em; display: flex; align-items: flex-end;
  }
  .hero .meta { color: var(--muted); font-size: .85rem; margin-top: .35rem; }
  .hero .meta b { color: var(--text); font-weight: 600; }
  .hero .cta { display: flex; gap: .6rem; margin-top: .9rem; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    border: none; border-radius: 10px; padding: .7rem 1.1rem;
    font-size: .95rem; font-weight: 700; min-height: 44px;
  }
  .btn svg { flex: none; }
  .btn-primary { background: var(--red); color: #fff; box-shadow: 0 8px 24px rgba(230,36,41,.35); }
  .btn-ghost { background: rgba(255,255,255,.08); color: var(--text); border: 1px solid rgba(255,255,255,.18); }
  @media (hover: hover) {
    .btn-primary:hover { background: #f03338; }
    .btn-ghost:hover { border-color: rgba(255,255,255,.45); }
  }

  .hero.finale { background: linear-gradient(150deg, #a3141a, #4b070a); border-color: #b8353a; }
  .hero.finale .content { padding-top: 2.2rem; display: block; }
  .hero.finale h3 { font-size: clamp(2.4rem, 9vw, 3.4rem); }
  .hero.finale p { color: #ffd9da; margin-top: .3rem; max-width: 46ch; }

  /* ================= Poster grid ================= */
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; }
  .tile {
    position: relative; border: none; padding: 0; background: var(--surface2);
    border-radius: 10px; overflow: hidden; aspect-ratio: 2/3;
    transition: transform .18s ease;
  }
  .tile img { width: 100%; height: 100%; object-fit: cover; }
  .tile .fallback {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: .6rem; text-align: center; color: var(--text);
    font-family: var(--display); font-size: 1.05rem; letter-spacing: .05em;
    background: linear-gradient(160deg, var(--surface2), #232837);
  }
  .tile .num {
    position: absolute; top: 6px; left: 6px;
    font-family: var(--display); font-size: .95rem; letter-spacing: .05em;
    color: #fff; background: rgba(7,8,12,.72);
    padding: .1rem .42rem 0; border-radius: 6px;
  }
  .tile .done {
    position: absolute; right: 6px; bottom: 6px;
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--red); color: #fff;
    display: none; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(0,0,0,.5);
  }
  .tile.watched img { filter: grayscale(1) brightness(.5); }
  .tile.watched .done { display: flex; }
  .tile.next { box-shadow: 0 0 0 2px var(--red), 0 10px 30px rgba(230,36,41,.25); }
  .tile .kind {
    position: absolute; top: 6px; right: 6px;
    font-family: var(--display); font-size: .95rem; letter-spacing: .05em;
    color: #fff; background: rgba(7,8,12,.72);
    padding: .1rem .42rem 0; border-radius: 6px;
  }
  .tile .kind.hot { background: var(--red); }

  footer {
    max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 2.5rem;
    color: var(--muted); font-size: .78rem; line-height: 1.6;
    border-top: 1px solid var(--line);
  }
  footer a { color: var(--muted); }

  /* ================= Detail sheet ================= */
  #overlay {
    position: fixed; inset: 0; z-index: 60;
    background: rgba(4,5,8,.7);
    display: flex; align-items: flex-end; justify-content: center;
    opacity: 0; visibility: hidden;
    transition: opacity .25s ease, visibility 0s linear .3s;
  }
  #overlay.open { opacity: 1; visibility: visible; transition: opacity .25s ease; }
  #sheet {
    background: var(--surface); width: 100%; max-width: 680px;
    border-radius: 18px 18px 0 0; overflow: hidden;
    max-height: 92dvh; overflow-y: auto;
    transform: translateY(40px);
    transition: transform .32s cubic-bezier(.2,.85,.3,1);
  }
  #overlay.open #sheet { transform: none; }
  .sheet-head { position: relative; aspect-ratio: 16/8; background: var(--surface2); }
  .sheet-head img.bd { width: 100%; height: 100%; object-fit: cover; }
  .sheet-head::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(to top, var(--surface) 4%, rgba(16,19,26,.25) 55%, rgba(16,19,26,0));
  }
  .play-trailer {
    position: absolute; right: .9rem; bottom: .8rem; z-index: 2;
    display: inline-flex; align-items: center; gap: .35rem;
    background: rgba(7,8,12,.72); color: #fff; border: 1px solid rgba(255,255,255,.25);
    border-radius: 999px; padding: .5rem .95rem .5rem .6rem;
    font-size: .88rem; font-weight: 700; min-height: 44px;
    backdrop-filter: blur(6px);
    transition: border-color .15s, background .15s;
  }
  @media (hover: hover) { .play-trailer:hover { border-color: var(--red); background: rgba(230,36,41,.25); } }
  #trailer {
    position: fixed; inset: 0; z-index: 80; background: #000;
    display: none;
  }
  #trailer.open { display: block; }
  #trailer iframe { width: 100%; height: 100%; border: 0; display: block; }
  #trailer .sheet-close { top: max(.7rem, env(safe-area-inset-top)); }
  .sheet-close {
    position: absolute; top: .7rem; right: .7rem; z-index: 2;
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(7,8,12,.65); color: #fff; border: none;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(6px);
  }
  .sheet-body { position: relative; padding: 0 1.2rem 1.4rem; }
  .sheet-top { display: flex; gap: 1rem; align-items: flex-end; margin-top: -3.4rem; position: relative; z-index: 1; }
  .sheet-top .poster {
    width: 96px; aspect-ratio: 2/3; object-fit: cover; flex: none;
    border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,.6);
    background: var(--surface2);
  }
  .sheet-top h3 { font-family: var(--display); font-weight: 400; font-size: clamp(1.7rem, 6.5vw, 2.4rem); letter-spacing: .03em; line-height: .95; }
  .sheet-top .meta { color: var(--muted); font-size: .85rem; margin-top: .3rem; }
  .sheet-body .desc { line-height: 1.6; margin: 1rem 0 1.1rem; color: var(--text); max-width: 62ch; }
  .avail {
    display: flex; align-items: center; gap: .7rem;
    background: var(--surface2); border: 1px solid var(--line);
    border-radius: 12px; padding: .85rem 1rem; margin-bottom: 1.2rem;
    font-size: .92rem;
  }
  .avail svg { color: var(--muted); flex: none; }
  .avail b { font-weight: 600; }
  .avail { min-height: 56px; }
  .sheet-actions { display: flex; gap: .7rem; }
  .sheet-actions .btn-primary, .sheet-actions .btn-undo { flex: 1; justify-content: center; padding: .95rem; font-size: 1rem; }
  .btn-undo { background: var(--surface2); color: var(--muted); border: 1px solid var(--line); border-radius: 10px; font-weight: 700; }
  .btn-undo:hover { color: var(--text); border-color: var(--muted); }

  /* ================= Account-modal ================= */
  .account { position: relative; padding: 2.2rem 1.5rem 1.6rem; text-align: center; }
  .account .avatar {
    width: 72px; height: 72px; border-radius: 50%; margin: 0 auto .9rem;
    box-shadow: 0 10px 26px rgba(0,0,0,.5); background: var(--surface2);
  }
  .account h3 { font-family: var(--display); font-weight: 400; font-size: 1.7rem; letter-spacing: .04em; }
  .account .meta { color: var(--muted); font-size: .9rem; margin-top: .25rem; }
  .account .stats { margin: 1rem 0 1.4rem; color: var(--text); font-size: .95rem; }
  .account .sheet-actions { margin-bottom: .4rem; }
  .provider-btn {
    display: flex; align-items: center; justify-content: center; gap: .7rem;
    width: 100%; min-height: 48px; border-radius: 10px;
    border: 1px solid var(--line); background: var(--surface2);
    color: var(--text); font-size: .95rem; font-weight: 700;
    margin-bottom: .7rem; transition: border-color .15s;
  }
  @media (hover: hover) { .provider-btn:hover { border-color: var(--muted); } }
  .provider-btn svg { flex: none; }
  .btn-danger {
    background: none; border: none; color: var(--red); font-weight: 700;
    font-size: .9rem; padding: .8rem; width: 100%; border-radius: 8px; min-height: 44px;
  }
  @media (hover: hover) { .btn-danger:hover { background: rgba(230,36,41,.12); } }
  .account .warn { color: var(--muted); font-size: .9rem; line-height: 1.5; max-width: 40ch; margin: 0 auto 1.2rem; }
  .account .warn b { color: var(--text); }

  /* ================= Toast ================= */
  .toast {
    position: fixed; left: 50%; bottom: max(1.2rem, env(safe-area-inset-bottom));
    transform: translateX(-50%) translateY(90px);
    background: var(--surface2); border: 1px solid var(--line); color: var(--text);
    border-radius: 12px; padding: .55rem .55rem .55rem 1rem;
    display: flex; gap: .6rem; align-items: center;
    font-size: .9rem; z-index: 70; max-width: calc(100vw - 2rem);
    box-shadow: 0 12px 30px rgba(0,0,0,.55);
    transition: transform .35s cubic-bezier(.2,.85,.3,1);
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
  .toast span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .toast button {
    background: none; border: none; color: var(--red); font-weight: 700;
    font-size: .9rem; padding: .55rem .6rem; white-space: nowrap; border-radius: 8px;
  }
  @media (hover: hover) { .toast button:hover { background: rgba(230,36,41,.12); } }

  /* ================= iOS-installatiebanner ================= */
  .a2hs {
    position: fixed; left: .8rem; right: .8rem;
    bottom: max(.8rem, env(safe-area-inset-bottom));
    z-index: 65; display: none; gap: .7rem; align-items: center;
    background: var(--surface2); border: 1px solid var(--line); border-radius: 12px;
    padding: .8rem .4rem .8rem 1rem;
    box-shadow: 0 12px 30px rgba(0,0,0,.55);
    font-size: .88rem; line-height: 1.45;
  }
  .a2hs.show { display: flex; }
  .a2hs .share-icon { flex: none; color: var(--red); }
  .a2hs svg.inline { vertical-align: -3px; }
  .a2hs button {
    background: none; border: none; color: var(--muted); flex: none;
    min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center;
  }

  /* ================= Desktop ================= */
  @media (min-width: 760px) {
    .bar { padding: .75rem 1.5rem; }
    main { padding: 0 1.5rem 4rem; }
    .routes { grid-template-columns: repeat(3, 1fr); }
    .route { flex-direction: column; align-items: flex-start; padding: 1.3rem; }
    .fan { width: 110px; height: 120px; }
    .grid { grid-template-columns: repeat(6, 1fr); gap: .8rem; }
    .hero .content { padding: 9rem 1.6rem 1.6rem; }
    .hero .poster { width: 132px; }
    #overlay { align-items: center; padding: 2rem; }
    #sheet { border-radius: 18px; }
  }
</style>
</head>
<body>
<!--
THESIS: Eén beslissing per bezoek — "welke Marvel-film kijk ik nu?" — beantwoord met het artwork zelf; geen dashboard van kaartjes met icoontjes, de posters zíjn de interface.
OWN-WORLD: Diep zwart (#07080c) met Marvel-rood (#e62429) als enige identiteitskleur; Bebas Neue condensed display; TMDB-posters en -backdrops dragen alle overige kleur; dunne 1px lijnen, zachte diepe schaduwen.
STORY: Bezoeker landt in een flipbook-intro, kiest één keer een route, en ziet daarna altijd bovenaan de volgende film met afvink-actie; de grid eronder is het bewijs van voortgang.
FIRST VIEWPORT (mobiel): sticky balk met wordmark + teller; hero = backdrop van de volgende film met poster, titel in Bebas, meta en primaire rode "Gekeken"-knop onderin het beeld.
FORM: Cinematic streaming-premium — door gebruiker gepind via structured probe (geen concept-roll); mobile-first bottom-sheet grammatica.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->

<div id="intro" role="button" tabindex="0" aria-label="Intro overslaan">
  <div class="montage" id="montage"></div>
