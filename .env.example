# TMDB (verplicht voor live streamingdata) — gratis key via themoviedb.org → Instellingen → API
TMDB_KEY=

# Neon Postgres (verplicht voor accounts) — connection string van console.neon.tech
DATABASE_URL=

# Auth.js — genereer met: openssl rand -base64 33
AUTH_SECRET=

# Google-login — maak een OAuth-client op console.cloud.google.com (zie README)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple-login — vereist betaald Apple Developer-account (zie README)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
